# ── 网络 ─────────────────────────────────────────────────
PORT=3210
SERVER_BIND_HOST=0.0.0.0
BROWSER_WSS_PORT=3211
BROWSER_WSS_PATH=/ws/browser
# 留空则自动从请求 Host 头推导，跨网络部署时无需手动设置
BROWSER_MEDIA_ORIGIN=

# ── CORS ─────────────────────────────────────────────────
# 逗号分隔的额外允许源，如 http://192.168.1.100:3210
CORS_ALLOWED_ORIGINS=

# ── TLS 证书 ─────────────────────────────────────────────
# 留空则自动生成 localhost 自签证书到 server/.localhost-wss/
BROWSER_WSS_CERT_PATH=
BROWSER_WSS_KEY_PATH=
# 自动生成证书时追加的 SAN，如 IP:192.168.1.100,DNS:myhost.local
BROWSER_WSS_CERT_SAN=

# ── 自动回复 ─────────────────────────────────────────────
AUTO_REPLY_ENABLED=1
AUTO_REPLY_INTERVAL_MS=3000
AUTO_REPLY_DRY_RUN=0

# ── 浏览器侧巡逻 ─────────────────────────────────────────
CRAWLER_DESIRED_ENABLED=1

# ── LLM ──────────────────────────────────────────────────
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o

{
  "name": "goofish-aggregation-server",
  "version": "1.0.0",
  "description": "闲鱼聊天记录聚合服务",
  "main": "index.ts",
  "scripts": {
    "start": "node index.ts",
    "dev": "node --watch index.ts",
    "audit:chat-keys": "node audit_chat_key_switches.js",
    "build:frontend": "cd frontend && npm run build && cd ..",
    "dev:frontend": "cd frontend && npm run dev && cd ..",
    "worker": "node auto_reply_worker.ts",
    "worker:dry": "node auto_reply_worker.ts --dry-run",
    "worker:dry:once": "node auto_reply_worker.ts --dry-run --once",
    "worker:once": "node auto_reply_worker.ts --once"
  },
  "dependencies": {
    "express": "^4.22.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.19.0"
  }
}

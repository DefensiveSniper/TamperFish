# ── 服务端连接 ─────────────────────────────────────────────
SERVER_URL=http://127.0.0.1:3210
SERVER_HOST=
BROWSER_WSS_PORT=3211

# ── CDP 同步 ─────────────────────────────────────────────
CDP_PORT=18800
SYNC_INTERVAL=5000

# ── Chrome 配置 ──────────────────────────────────────────
CHROME_USER_DATA_DIR=
CHROME_PROFILE_DIRECTORY=
CHROME_PROFILE_NAME=
CHROME_MONITOR_INTERVAL_MS=
CHROME_START_TIMEOUT_MS=
CHROME_CLEAR_TRANSIENT_DATA_ON_START=

# ── Chrome 代理 ──────────────────────────────────────────
CHROME_PROXY_DISABLED=0
CHROME_PROXY_SERVER=
CHROME_PROXY_SCHEME=
CHROME_PROXY_USERNAME=
CHROME_PROXY_PASSWORD=
CHROME_PROXY_BYPASS_LIST=
CHROME_PROXY_CONFIG_PATH=

# ── 页面地址 ─────────────────────────────────────────────
GOOFISH_URL=
QIANNIU_URL=

# ── 日志 ─────────────────────────────────────────────────
RUNTIME_LOG_PATH=

# ── Tampermonkey ─────────────────────────────────────────
CHROME_TAMPERMONKEY_WEBREQUEST_EVENT_THRESHOLD=
CHROME_REPAIR_TAMPERMONKEY_WEBREQUEST_ON_START=

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "moduleDetection": "force"
  },
  "include": [
    "main.ts",
    "integrations/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": [
    "server/public/**",
    "chrome_extension/**",
    "frontend/**",
    "node_modules/**"
  ]
}